<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet author="cgeorgilakis@grnet.gr" id="openid-federation">
    	<createTable tableName="OPENID_FEDERATION">
             <column name="INTERNAL_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="TRUST_ANCHOR" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="OPENID_FEDERATION_ATTRIBUTE">
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="VALUE" type="longvarchar"/>
            <column name="OPENID_FEDERATION_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="INTERNAL_ID" constraintName="OPENID_FEDERATION_PK" tableName="OPENID_FEDERATION"/>
        <addForeignKeyConstraint baseColumnNames="REALM_ID" baseTableName="OPENID_FEDERATION" constraintName="REALM_OPENID_FEDERATION_KEY" referencedColumnNames="ID" referencedTableName="REALM" />
        <addPrimaryKey columnNames="NAME, OPENID_FEDERATION_ID" constraintName="OPENID_FEDERATION_ATTRIBUTE_PK" tableName="OPENID_FEDERATION_ATTRIBUTE"/>
        <addForeignKeyConstraint baseColumnNames="OPENID_FEDERATION_ID" baseTableName="OPENID_FEDERATION_ATTRIBUTE" constraintName="OPENID_FEDERATION_ATTRIBUTE_FK" referencedColumnNames="INTERNAL_ID" referencedTableName="OPENID_FEDERATION"/>
    </changeSet>

    <changeSet author="cgeorgilakis@grnet.gr" id="openid-federation-unique">
        <addUniqueConstraint columnNames="REALM_ID,TRUST_ANCHOR" constraintName="OPENID_FEDERATION_UNIQUE" tableName="OPENID_FEDERATION"/>
    </changeSet>

    <changeSet author="cgeorgilakis@grnet.gr" id="openid-federation-idp">
        <createTable tableName="OPENID_FEDERATION_IDP_CONFIGURATION">
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="VALUE" type="longvarchar"/>
            <column name="OPENID_FEDERATION_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="NAME, OPENID_FEDERATION_ID" constraintName="OPENID_FEDERATION_IDP_CONFIGURATION_PK" tableName="OPENID_FEDERATION_IDP_CONFIGURATION"/>
        <addForeignKeyConstraint baseColumnNames="OPENID_FEDERATION_ID" baseTableName="OPENID_FEDERATION_IDP_CONFIGURATION" constraintName="OPENID_FEDERATION_IDP_CONFIGURATION_FK" referencedColumnNames="INTERNAL_ID" referencedTableName="OPENID_FEDERATION"/>
    </changeSet>

    <changeSet author="cgeorgilakis@grnet.gr" id="openid-federation2">
        <addColumn tableName="OPENID_FEDERATION">
            <column name="ENTITY_TYPE" type="VARCHAR(256)"/>
        </addColumn>
    </changeSet>

    <changeSet author="cgeorgilakis@grnet.gr" id="openid-federation2-populate">
        <sql>
            MERGE INTO OPENID_FEDERATION fed
            USING (
            SELECT o.openid_federation_id,
            o.value
            FROM (
            SELECT o.*,
            ROW_NUMBER() OVER (PARTITION BY o.openid_federation_id ORDER BY o.id) rn
            FROM openid_federation_attribute o
            WHERE o.name = 'openidFederationEntityTypes'
            ) o
            WHERE rn = 1
            ) sub
            ON (fed.internal_id = sub.openid_federation_id)
            WHEN MATCHED THEN
            UPDATE SET ENTITY_TYPE = sub.value;
        </sql>

        <sql>
            DELETE FROM openid_federation_attribute
            WHERE name = 'openidFederationEntityTypes';
        </sql>
    </changeSet>

    <changeSet author="cgeorgilakis@grnet.gr" id="openid-federation2-notnull">
        <addNotNullConstraint
                tableName="OPENID_FEDERATION"
                columnName="ENTITY_TYPE"
                columnDataType="VARCHAR(256)"/>
        <dropUniqueConstraint
                tableName="OPENID_FEDERATION"
                constraintName="OPENID_FEDERATION_UNIQUE"/>
        <addUniqueConstraint
                tableName="OPENID_FEDERATION"
                columnNames="REALM_ID,TRUST_ANCHOR,ENTITY_TYPE"
                constraintName="OPENID_FEDERATION_UNIQUE"/>
    </changeSet>

</databaseChangeLog>
